{
  "schemaVersion": "2026-05-dndc-lite-crop-db-v1",
  "name": "DNDC-lite crop growth database",
  "description": "Ten-crop parameter database for daily crop growth, irrigation, fertilization, plant protection scheduling, and yield prediction. It uses DNDC-style drivers and daily balance logic without copying DNDC or ORIFORI source code.",
  "units": {
    "area": "ha",
    "yield": "kg/ha fresh or harvest product weight",
    "water": "mm/season",
    "nutrients": "kg/ha as N, P2O5, K2O",
    "temperature": "degree Celsius",
    "gdd": "degree-days above crop base temperature"
  },
  "modelLogic": {
    "drivers": ["climate", "soil", "crop", "management"],
    "dailySteps": [
      "calculate daily growing degree days from mean temperature and crop base temperature",
      "advance phenology by accumulated GDD divided by crop thermal requirement",
      "estimate stage crop evapotranspiration from ET0 and Kc curve",
      "update root-zone soil water balance with rainfall, irrigation, ETc, drainage, and soil water storage",
      "calculate daily nutrient demand by stage uptake curve and daily phenology increment",
      "estimate nitrogen stress from available mineral N, water stress, and crop demand",
      "apply management events for basal fertilizer, topdressing, irrigation, pest scouting, and harvest",
      "convert cumulative temperature, water stress, nitrogen stress, pH, salinity, and management timing to yield factor"
    ],
    "formulas": {
      "dailyGdd": "max(0, min(tmean, thermal.maxTempC) - thermal.baseTempC)",
      "phenology": "min(1, accumulatedGdd / thermal.totalGddC)",
      "stageEtc": "dailyET0 * interpolatedKc(stage)",
      "rootZoneTawMm": "(soil.fieldCapacity - soil.wiltingPoint) * rootDepthMm",
      "waterStress": "availableWaterMm / max(readilyAvailableWaterMm, 1)",
      "dailyNutrientDemand": "seasonNutrientDemand * stage.nutrientShare * dailyPhenologyIncrement / stage.thermalShare",
      "yieldFactor": "temperatureFactor * waterFactor * nitrogenFactor * soilFactor * salinityFactor * facilityFactor"
    },
    "dndcMapping": {
      "thermal.totalGddC": "DNDC-style CropTDD",
      "water.seasonRequirementMm": "DNDC-style crop water requirement converted to seasonal water planning",
      "nutrientDemandKgHa.n": "DNDC-style max crop N demand, used for daily N demand",
      "biomassPartition": "DNDC-style mature biomass partition among harvest organ, leaves/stems, and roots",
      "cnRatio": "DNDC-style C/N ratio for plant organs, used later for residue and N balance"
    }
  },
  "validationRules": {
    "requiredCropCount": 10,
    "requiredCropFields": [
      "id",
      "name",
      "category",
      "thermal",
      "water",
      "nutrientDemandKgHa",
      "yieldPotentialKgHa",
      "stages",
      "managementTemplates",
      "sourceIds"
    ],
    "stageRules": [
      "stage thermalShare values must sum to 1.00",
      "stage nShare, pShare, kShare, and waterShare must each sum to 1.00",
      "stage order must be continuous from early establishment to maturity",
      "each crop must include at least one fertilizer, irrigation, scouting, and harvest recommendation"
    ],
    "rangeRules": {
      "thermal": "baseTempC < optTempC < maxTempC and totalGddC > 0",
      "water": "seasonRequirementMm must fall inside validationRangeMm when FAO crop water range exists",
      "nutrients": "N, P2O5, and K2O must be non-negative and realistic for the target yield class",
      "soil": "phMin < phOptLow <= phOptHigh < phMax; salinityThresholdDsM > 0"
    }
  },
